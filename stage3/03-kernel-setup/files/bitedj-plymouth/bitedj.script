# Touch Display 2 exposes its portrait-native 720x1280 framebuffer before Sway
# applies the kiosk's landscape transform. Use a pre-rotated asset because the
# Plymouth script renderer does not reliably expand bounds after Image.Rotate.
if (Window.GetHeight() > Window.GetWidth()) {
    background_image = Image("wallpaper-portrait.png");
} else {
    background_image = Image("wallpaper.png");
}

screen_ratio = Window.GetHeight() / Window.GetWidth();
bg_image_ratio = background_image.GetHeight() / background_image.GetWidth();

if (screen_ratio > bg_image_ratio) {
    scale_factor = Window.GetHeight() / background_image.GetHeight();
} else {
    scale_factor = Window.GetWidth() / background_image.GetWidth();
}

scaled_bg = background_image.Scale(background_image.GetWidth() * scale_factor, background_image.GetHeight() * scale_factor);

background_sprite = Sprite(scaled_bg);
background_sprite.SetX((Window.GetWidth() - scaled_bg.GetWidth()) / 2);
background_sprite.SetY((Window.GetHeight() - scaled_bg.GetHeight()) / 2);
background_sprite.SetZ(-10000);
